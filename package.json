{
  "name": "honkai-chat",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "games/robots"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts && node --test tests/*.test.mjs && npm test --workspace=@honkai-chat/robots",
    "test:e2e": "playwright test",
    "dev": "npm run dev --workspace=client --",
    "build": "npm run build --workspace=client && npm run build --workspace=@honkai-chat/robots",
    "preview": "npm run preview --workspace=client --",
    "start": "node server/start.mjs",
    "sync:robots": "node scripts/sync-robots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pngjs": "^6.0.5",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
